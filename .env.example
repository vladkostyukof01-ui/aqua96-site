# Скопируйте этот файл в .env и заполните перед запуском на реальном хостинге.
# Локально можно обойтись без .env — сервер подставит безопасные значения
# по умолчанию для разработки.

# Порт, на котором запускается сервер (хостинг часто задаёт его сам)
PORT=3502

# Секрет для подписи сессий администратора — обязательно замените на длинную
# случайную строку перед деплоем на реальный хостинг
SESSION_SECRET=замените-на-длинную-случайную-строку-перед-деплоем

# Логин и пароль администратора, которые создаст npm run seed при первом запуске
# (если админ уже создан в базе — эти переменные игнорируются)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=замените-на-свой-пароль

# production включает более строгие cookie (secure — только по HTTPS)
NODE_ENV=development
